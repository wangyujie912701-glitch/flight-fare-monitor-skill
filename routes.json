    "platform_points_are_bank_cashback": false
  },
  "routes": [
    {
      "id": "sample-round-trip",
      "active": true,
      "journey_type": "round_trip",
      "outbound": { "date": "2027-03-10", "from": ["AAA"], "to": ["BBB"] },
